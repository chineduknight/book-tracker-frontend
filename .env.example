# Copy to .env.local for local development. Never commit real values. Every variable is server-only:
# none may ever be renamed with a NEXT_PUBLIC_ prefix. The app fails closed (503 on sign-in, an error
# page on private pages) when any of them is missing or invalid.

# The exact origin browsers use for this app. Sign-in, registration and logout accept requests only
# from this origin. https:// for any deployment; http:// is accepted only for a loopback host.
APP_ORIGIN=http://localhost:3100

# The Book Tracker API, including /api/v1. A LOCAL development API here.
API_BASE_URL=http://localhost:3000/api/v1

# A dedicated MongoDB database for web sessions only (never the API's own database). A remote
# server must use TLS (mongodb+srv://, or mongodb://...?tls=true); plaintext is accepted only on
# loopback. Locally, a disposable MongoDB 8, e.g.:
#   docker run -d --rm --name avuneri-bff-mongo -p 127.0.0.1:27018:27017 mongo:8.0
BFF_SESSION_MONGODB_URI=mongodb://127.0.0.1:27018/avuneri-bff-dev

# 32 random bytes, base64url. Encrypts stored API tokens and keys session verifiers. There is no
# default. Generate it straight into .env.local so it is never printed:
#   echo "BFF_SESSION_ENCRYPTION_KEY=$(node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64url'))")" >> .env.local
BFF_SESSION_ENCRYPTION_KEY=
