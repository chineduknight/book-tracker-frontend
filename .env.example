# Copy to .env.local for local development. Never commit real values.
#
# FE #15 renders static placeholders only and does not read this variable at build or render time.
# It is reserved for the server-only API client (src/lib/api/server.ts), which later milestones will
# use from server code. It must never be renamed with a NEXT_PUBLIC_ prefix.
#
# Base URL of a LOCAL development Book Tracker API, including the /api/v1 prefix.
API_BASE_URL=http://localhost:3000/api/v1
