{
  "name": "book-tracker-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-first web app for a private personal library and reading companion.",
  "license": "MIT",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:accessibility": "playwright test e2e/accessibility.spec.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:ci": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:integration && npm run test:backend && npm run check:contrast && npm run build && npm run check:bundle && npm run test:e2e",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "session-store:indexes": "tsx --conditions=react-server scripts/session-store-indexes.mts",
    "check:contrast": "node scripts/check-contrast.mjs",
    "test:backend": "vitest run --config vitest.backend.config.mts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "mongodb": "7.9.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
